LLM_ENABLED=true
LLM_PROVIDER=glm

# GLM / Zhipu BigModel OpenAI-compatible chat completions.
GLM_API_KEY=
GLM_MODEL=glm-5.1
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Optional generic aliases. These take precedence when set.
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1600
LLM_REQUEST_TIMEOUT_MS=60000

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

API_BASE_URL=http://localhost:8000
